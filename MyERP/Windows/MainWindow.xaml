<Window
    x:Class="MyERP.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
    Width="1100"
    Height="700"
    MinWidth="1100"
    MinHeight="700"
    AllowsTransparency="True"
    Background="Transparent"
    FontFamily="Segoe UI"
    ResizeMode="CanResizeWithGrip"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">

    <Border Background="#F3F4F6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="50" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid
                Grid.Row="0"
                Background="#1E293B"
                MouseLeftButtonDown="WindowHeader_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Margin="15,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="MyERP | Учет поставок и продаж" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        x:Name="UserRoleTextBlock"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="#94A3B8"
                        Text="Пользователь" />
                    <Button
                        Height="40"
                        Margin="15,0,10,0"
                        Click="Button_Click"
                        Content="⏻"
                        FontWeight="Bold"
                        Style="{StaticResource WindowControlButtonStyle}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button
                        Width="45"
                        Height="40"
                        Click="MinimizeButton_Click"
                        Style="{StaticResource WindowControlButtonStyle}">
                        <Path
                            Data="M 1,6 L 15,6"
                            Stroke="White"
                            StrokeEndLineCap="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="2.5" />
                    </Button>
                    <Button
                        Width="45"
                        Height="40"
                        Click="MaximizeButton_Click"
                        Style="{StaticResource WindowControlButtonStyle}">
                        <Path
                            Data="M 1,1 L 12,1 12,12 1,12 Z"
                            Fill="Transparent"
                            Stroke="White"
                            StrokeLineJoin="Round"
                            StrokeThickness="2" />
                    </Button>
                    <Button
                        Width="45"
                        Height="40"
                        Click="CloseButton_Click"
                        Style="{StaticResource WindowCloseButtonStyle}">
                        <Path
                            Data="M 1,1 L 12,12 M 12,1 L 1,12"
                            Stroke="White"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="2.5" />
                    </Button>
                </StackPanel>
            </Grid>

            <Border
                Grid.Row="1"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Margin="20,0,0,0"
                        VerticalAlignment="Center"
                        FontFamily="Segoe UI Black"
                        FontSize="12"
                        Foreground="#9CA3AF"
                        Text="РАЗДЕЛЫ" />

                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Button
                            x:Name="Товары"
                            Click="Товары_Click"
                            Content="🏷️ ТОВАРЫ"
                            Style="{StaticResource TopNavButtonStyle}"
                            Tag="Active" />
                        <Button
                            x:Name="Поставки"
                            Click="Поставки_Click"
                            Content="📥 ПОСТАВКИ"
                            Style="{StaticResource TopNavButtonStyle}" />
                        <Button
                            x:Name="Продажи"
                            Click="Продажи_Click"
                            Content="🛒 ПРОДАЖИ"
                            Style="{StaticResource TopNavButtonStyle}" />
                        <Button
                            x:Name="Пользователи"
                            Click="Пользователи_Click"
                            Content="👤 ПОЛЬЗОВАТЕЛИ"
                            Style="{StaticResource TopNavButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Background="#F3F4F6">
                <Frame
                    x:Name="MainFrame"
                    Background="Transparent"
                    NavigationUIVisibility="Hidden" />
            </Grid>
        </Grid>
    </Border>
</Window>