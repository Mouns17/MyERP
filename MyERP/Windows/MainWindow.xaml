<Window
    x:Class="MyERP.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="1100"
    Height="700"
    MinWidth="1100"
    MinHeight="700"
    AllowsTransparency="True"
    Background="Transparent"
    FontFamily="Segoe UI"
    ResizeMode="CanResizeWithGrip"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">
    <Border Background="#DCDCDC">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="35" />
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid
                Grid.Row="0"
                Background="#151719"
                MouseLeftButtonDown="WindowHeader_MouseLeftButtonDown">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Margin="20,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="ERP | Учет поставок и продаж в торговой фирме" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Margin="0,0,50,0"
                    VerticalAlignment="Center"
                    Orientation="Vertical">
                    <TextBlock
                        HorizontalAlignment="Right"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="Администратор" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <!--  Свернуть  -->
                    <Button
                        Click="MinimizeButton_Click"
                        Content="➖"
                        Style="{StaticResource WindowControlButtonStyle}" />

                    <!--  Развернуть  -->
                    <Button
                        x:Name="MaximizeButton"
                        Click="MaximizeButton_Click"
                        Content="🔲"
                        Style="{StaticResource WindowControlButtonStyle}" />

                    <!--  Закрыть  -->
                    <Button
                        Click="CloseButton_Click"
                        Content="✖︎"
                        Style="{StaticResource WindowCloseButtonStyle}" />
                </StackPanel>
            </Grid>
            <Grid
                Grid.Row="1"
                Margin="0,3,0,0"
                Background="#FFFAF0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>


                <StackPanel Grid.Column="0" Margin="10,0,10,0">
                    <TextBlock
                        Margin="19,12,0,0"
                        HorizontalAlignment="Left"
                        FontFamily="Segoe UI Black"
                        FontSize="12"
                        Foreground="Gray"
                        Text="РАЗДЕЛЫ" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Margin="0,0,10,0"
                    Orientation="Horizontal">
                    <Button
                        x:Name="Обзор"
                        Width="130"
                        Height="37"
                        HorizontalAlignment="Left"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Click="Обзор_Click"
                        Content="🔎 ОБЗОР"
                        FontWeight="Bold"
                        Foreground="#151719" />
                    <Button
                        x:Name="Товары"
                        Width="130"
                        Height="37"
                        HorizontalAlignment="Left"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Click="Товары_Click"
                        Content="🏷️ ТОВАРЫ"
                        FontWeight="Bold"
                        Foreground="#151719" />
                    <Button
                        x:Name="Поставки"
                        Width="130"
                        Height="37"
                        HorizontalAlignment="Left"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Click="Поставки_Click"
                        Content="📥 ПОСТАВКИ"
                        FontWeight="Bold"
                        Foreground="#151719" />
                    <Button
                        x:Name="Продажи"
                        Width="130"
                        Height="37"
                        HorizontalAlignment="Left"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Click="Продажи_Click"
                        Content="🛒 ПРОДАЖИ"
                        FontWeight="Bold"
                        Foreground="#151719" />
                    <Button
                        x:Name="Логи"
                        Width="130"
                        Height="37"
                        HorizontalAlignment="Left"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Click="Логи_Click"
                        Content="🗃️ ЛОГИ"
                        FontWeight="Bold"
                        Foreground="#151719" />
                    <Button
                        x:Name="Пользователи"
                        Width="130"
                        Height="37"
                        HorizontalAlignment="Left"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Click="Пользователи_Click"
                        Content="👤 ПОЛЬЗОВАТЕЛИ"
                        FontWeight="Bold"
                        Foreground="#151719" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2">
                <Border Margin="10,10,10,0" Background="#FFFAF0">
                    <Frame
                        x:Name="MainFrame"
                        Background="Transparent"
                        NavigationUIVisibility="Hidden" />
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>