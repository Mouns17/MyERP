<Window
    x:Class="MyERP.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="1400"
    Height="800"
    MinWidth="1100"
    MinHeight="700"
    AllowsTransparency="True"
    Background="Transparent"
    FontFamily="Segoe UI"
    ResizeMode="CanResizeWithGrip"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">
    <Border Background="#DCDCDC">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="35" />
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="#151719">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    Grid.Row="0"
                    Grid.Column="0"
                    Background="Transparent"
                    BorderBrush="#DCDCDC"
                    BorderThickness="0,0,0,1" />
                <Border
                    Grid.Row="0"
                    Grid.Column="1"
                    Background="Transparent"
                    BorderBrush="#DCDCDC"
                    BorderThickness="0,0,0,1" />
                <Border
                    Grid.Row="0"
                    Grid.Column="2"
                    Background="Transparent"
                    BorderBrush="#DCDCDC"
                    BorderThickness="0,0,0,1" />

                <StackPanel
                    Margin="20,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="ERP | Учет поставок и продаж в торговой фирме" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Margin="0,0,50,0"
                    VerticalAlignment="Center"
                    Orientation="Vertical">
                    <TextBlock
                        HorizontalAlignment="Right"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="Иванов И.И" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <!--  Свернуть  -->
                    <Button
                        Click="MinimizeButton_Click"
                        Content="—"
                        Style="{StaticResource WindowControlButtonStyle}" />

                    <!--  Развернуть  -->
                    <Button
                        x:Name="MaximizeButton"
                        Click="MaximizeButton_Click"
                        Content="□"
                        Style="{StaticResource WindowControlButtonStyle}" />

                    <!--  Закрыть  -->
                    <Button
                        Click="CloseButton_Click"
                        Content="✕"
                        Style="{StaticResource WindowCloseButtonStyle}" />
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1" Background="#FFFAF0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>


                <StackPanel Grid.Column="0" Margin="10,0,10,0">
                    <TextBlock
                        Margin="10,13"
                        HorizontalAlignment="Left"
                        FontFamily="Segoe UI Black"
                        FontSize="10"
                        Foreground="Gray"
                        Text="РАЗДЕЛЫ" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="10,0,10,0">
                    <Button
                        x:Name="Обзор"
                        Width="100"
                        Height="40"
                        HorizontalAlignment="Left"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Click="Обзор_Click"
                        Content="ОБЗОР"
                        FontFamily="Segoe UI Black"
                        Foreground="#151719" />
                    <Button
                        x:Name="Товары"
                        Width="100"
                        Height="40"
                        Margin="100,-40,0,0"
                        HorizontalAlignment="Left"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Click="Товары_Click"
                        Content="ТОВАРЫ"
                        FontFamily="Segoe UI Black"
                        Foreground="#151719" />
                    <Button
                        x:Name="Поставки"
                        Width="100"
                        Height="40"
                        Margin="200,-40,0,0"
                        HorizontalAlignment="Left"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Click="Поставки_Click"
                        Content="ПОСТАВКИ"
                        FontFamily="Segoe UI Black"
                        Foreground="#151719" />
                    <Button
                        x:Name="Продажи"
                        Width="100"
                        Height="40"
                        Margin="300,-40,0,0"
                        HorizontalAlignment="Left"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Click="Продажи_Click"
                        Content="ПРОДАЖИ"
                        FontFamily="Segoe UI Black"
                        Foreground="#151719" />
                    <Button
                        x:Name="Склады"
                        Width="100"
                        Height="40"
                        Margin="400,-40,0,0"
                        HorizontalAlignment="Left"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Click="Склады_Click"
                        Content="СКЛАДЫ"
                        FontFamily="Segoe UI Black"
                        Foreground="#151719" />
                    <Button
                        x:Name="Логи"
                        Width="100"
                        Height="40"
                        Margin="500,-40,0,0"
                        HorizontalAlignment="Left"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Click="Логи_Click"
                        Content="ЛОГИ"
                        FontFamily="Segoe UI Black"
                        Foreground="#151719" />
                    <Button
                        x:Name="Пользователи"
                        Width="110"
                        Height="40"
                        Margin="600,-40,0,0"
                        HorizontalAlignment="Left"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Click="Пользователи_Click"
                        Content="ПОЛЬЗОВАТЕЛИ"
                        FontFamily="Segoe UI Black"
                        Foreground="#151719" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2">
                <Border Margin="10,10,10,0" Background="#FFFAF0">
                    <Frame
                        x:Name="MainFrame"
                        Background="Transparent"
                        NavigationUIVisibility="Hidden" />
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>