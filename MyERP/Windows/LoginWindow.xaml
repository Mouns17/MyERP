<Window
    x:Class="MyERP.Windows.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="520"
    Height="560"
    MinWidth="460"
    MinHeight="500"
    AllowsTransparency="True"
    Background="Transparent"
    FontFamily="Segoe UI"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">

    <Border
        Background="#F3F4F6"
        BorderBrush="#D1D5DB"
        BorderThickness="1"
        CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="20"
                Opacity="0.15"
                ShadowDepth="5"
                Color="Black" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Background="#1E293B"
                CornerRadius="7,7,0,0"
                MouseLeftButtonDown="WindowHeader_MouseLeftButtonDown">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Margin="18,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="MyERP  |  Авторизация" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal">

                        <Button
                            Width="42"
                            Height="42"
                            Click="MinimizeButton_Click"
                            Content="➖"
                            Style="{StaticResource WindowControlButtonStyle}" />

                        <Button
                            x:Name="MaximizeButton"
                            Width="42"
                            Height="42"
                            Click="MaximizeButton_Click"
                            Content="🔲"
                            Style="{StaticResource WindowControlButtonStyle}" />

                        <Button
                            Width="42"
                            Height="42"
                            Click="CloseButton_Click"
                            Content="✖︎"
                            Style="{StaticResource WindowCloseButtonStyle2}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="30,0,30,35">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel
                    Grid.Row="0"
                    Margin="0,20,0,10"
                    HorizontalAlignment="Center">

                    <TextBlock
                        Margin="0,12,0,3"
                        HorizontalAlignment="Center"
                        FontFamily="Segoe UI Black"
                        FontSize="32"
                        Foreground="#2563EB"
                        Text="MyERP" />

                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="#6B7280"
                        Text="Система учёта поставок и продаж" />
                </StackPanel>

                <Border
                    Grid.Row="1"
                    Padding="30"
                    VerticalAlignment="Center"
                    Background="White"
                    CornerRadius="10">
                    <Border.Effect>
                        <DropShadowEffect
                            BlurRadius="15"
                            Opacity="0.1"
                            ShadowDepth="2"
                            Color="Gray" />
                    </Border.Effect>

                    <StackPanel>

                        <TextBlock
                            Margin="0,0,0,5"
                            FontFamily="Segoe UI Black"
                            FontSize="20"
                            Foreground="#151719"
                            Text="ВХОД В СИСТЕМУ" />

                        <TextBlock
                            Margin="0,0,0,25"
                            FontSize="13"
                            Foreground="#6B7280"
                            Text="Введите данные своей учётной записи" />

                        <TextBlock
                            Margin="0,0,0,7"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="#4B5563"
                            Text="Логин" />

                        <TextBox
                            x:Name="LoginTBox"
                            Height="42"
                            Padding="12,0"
                            VerticalContentAlignment="Center"
                            Background="#F9FAFB"
                            BorderBrush="#D1D5DB"
                            BorderThickness="1"
                            FontSize="14"
                            Foreground="#151719"
                            KeyDown="LoginTBox_KeyDown"
                            ToolTip="Введите логин" />

                        <TextBlock
                            Margin="0,18,0,7"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="#4B5563"
                            Text="Пароль" />

                        <PasswordBox
                            x:Name="PasswordTBox"
                            Height="42"
                            Padding="12,0"
                            VerticalContentAlignment="Center"
                            Background="#F9FAFB"
                            BorderBrush="#D1D5DB"
                            BorderThickness="1"
                            FontSize="14"
                            Foreground="#151719"
                            KeyDown="PasswordTBox_KeyDown"
                            ToolTip="Введите пароль" />

                        <Button
                            x:Name="LoginButton"
                            Height="45"
                            Margin="0,18,0,0"
                            Click="LoginButton_Click"
                            Content="ВОЙТИ В СИСТЕМУ"
                            FontFamily="Segoe UI Black"
                            FontSize="14"
                            Style="{StaticResource BtnPrimary}" />

                    </StackPanel>
                </Border>

                <TextBlock
                    Grid.Row="2"
                    Margin="0,18,0,0"
                    HorizontalAlignment="Center"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Foreground="#9CA3AF"
                    Text="MyERP v2026" />
            </Grid>
        </Grid>
    </Border>
</Window>