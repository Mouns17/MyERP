<Window
    x:Class="TradeEnterprise.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="1400"
    Height="800"
    MinWidth="1100"
    MinHeight="700"
    AllowsTransparency="True"
    Background="Transparent"
    FontFamily="Segoe UI"
    ResizeMode="CanResizeWithGrip"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/WindowControlButtonStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="#edeeef">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="35" />
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="#151719">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    Grid.Row="0"
                    Grid.Column="0"
                    Background="Transparent"
                    BorderBrush="#F5FFFA"
                    BorderThickness="0,0,0,1" />
                <Border
                    Grid.Row="0"
                    Grid.Column="1"
                    Background="Transparent"
                    BorderBrush="#F5FFFA"
                    BorderThickness="0,0,0,1" />
                <Border
                    Grid.Row="0"
                    Grid.Column="2"
                    Background="Transparent"
                    BorderBrush="#F5FFFA"
                    BorderThickness="0,0,0,1" />

                <StackPanel
                    Margin="20,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="Учет поставок и продаж" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <!--  Свернуть  -->
                    <Button
                        Click="MinimizeButton_Click"
                        Content="—"
                        Style="{DynamicResource WindowControlButtonStyle}" />

                    <!--  Развернуть  -->
                    <Button
                        x:Name="MaximizeButton"
                        Click="MaximizeButton_Click"
                        Content="□"
                        Style="{StaticResource WindowControlButtonStyle}" />

                    <!--  Закрыть  -->
                    <Button
                        Click="CloseButton_Click"
                        Content="✕"
                        Style="{StaticResource WindowControlButtonStyle}" />
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="#EAE6CA">


                    <StackPanel Grid.Column="0" Margin="10,0,10,0">
                        <TextBlock
                            Margin="10,13"
                            HorizontalAlignment="Left"
                            FontFamily="Segoe UI Black"
                            FontSize="10"
                            Foreground="Gray"
                            Text="РАЗДЕЛЫ" />

                        <Button x:Name="Обзор" />
                        <Button x:Name="Товары" />
                        <Button x:Name="Поставки" />
                        <Button x:Name="Продажи" />
                        <Button x:Name="Склады" />
                        <Button x:Name="Отчеты" />

                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="2">
                <Border
                    Margin="20"
                    Background="#EAE6CA"
                    CornerRadius="30" />
            </Grid>
        </Grid>
    </Border>
</Window>