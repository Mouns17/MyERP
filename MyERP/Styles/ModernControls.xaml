<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Базовые цвета  -->
    <SolidColorBrush x:Key="PrimaryBlue" Color="#2563EB" />
    <SolidColorBrush x:Key="SuccessGreen" Color="#16A34A" />
    <SolidColorBrush x:Key="DangerRed" Color="#DC2626" />
    <SolidColorBrush x:Key="GrayBg" Color="#6B7280" />

    <!--  Базовый стиль кнопок  -->
    <Style x:Key="BtnPrimary" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PrimaryBlue}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="20,10" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="bg"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Opacity" Value="0.8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Зеленая кнопка (Сохранить/Провести)  -->
    <Style
        x:Key="BtnSuccess"
        BasedOn="{StaticResource BtnPrimary}"
        TargetType="Button">
        <Setter Property="Background" Value="{StaticResource SuccessGreen}" />
    </Style>

    <!--  Красная кнопка (Удалить)  -->
    <Style
        x:Key="BtnDanger"
        BasedOn="{StaticResource BtnPrimary}"
        TargetType="Button">
        <Setter Property="Background" Value="{StaticResource DangerRed}" />
        <Setter Property="Padding" Value="15,10" />
    </Style>

    <!--  Серая кнопка (Назад/Отмена)  -->
    <Style
        x:Key="BtnSecondary"
        BasedOn="{StaticResource BtnPrimary}"
        TargetType="Button">
        <Setter Property="Background" Value="{StaticResource GrayBg}" />
    </Style>

    <!--  Стили для полей ввода  -->
    <Style TargetType="TextBox">
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="BorderBrush" Value="#D1D5DB" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="White" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="Padding" Value="6" />
        <Setter Property="BorderBrush" Value="#D1D5DB" />
        <Setter Property="Background" Value="White" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!--  Стиль для кнопок верхней навигации (в шапке)  -->
    <Style x:Key="TopNavButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#6B7280" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="15,10" />
        <Setter Property="Margin" Value="5,0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Border
                            x:Name="bg"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <!--  Полоска снизу для активного раздела  -->
                        <Border
                            x:Name="indicator"
                            Height="3"
                            Margin="10,0"
                            VerticalAlignment="Bottom"
                            Background="Transparent"
                            CornerRadius="1.5" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="#F3F4F6" />
                            <Setter Property="Foreground" Value="#1F2937" />
                        </Trigger>
                        <Trigger Property="Tag" Value="Active">
                            <Setter TargetName="indicator" Property="Background" Value="#2563EB" />
                            <Setter Property="Foreground" Value="#2563EB" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Стиль для внутренних вкладок (Поставки, Продажи и т.д.)  -->
    <Style x:Key="TabButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#4B5563" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="20,8" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="border"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#D1D5DB" />
                        </Trigger>
                        <Trigger Property="Tag" Value="Active">
                            <Setter TargetName="border" Property="Background" Value="White" />
                            <Setter Property="Foreground" Value="#2563EB" />
                            <Setter TargetName="border" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect
                                        BlurRadius="5"
                                        Opacity="0.1"
                                        ShadowDepth="1"
                                        Color="Gray" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>