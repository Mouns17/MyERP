<Page
    x:Class="MyERP.Pages.SuppliesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MyERP.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="#FFFAF0"
    mc:Ignorable="d">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,20"
            FontFamily="Segoe UI Black"
            FontSize="20"
            Foreground="#151719"
            Text="ПОСТАВКИ" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBox
                Grid.Column="0"
                Padding="8"
                BorderBrush="#151719"
                Text="Поиск..." />

            <StackPanel
                Grid.Column="1"
                Margin="10,0,0,0"
                Orientation="Horizontal">
                <Button Content="ДОБАВИТЬ" />
            </StackPanel>
        </Grid>
        <DataGrid
            x:Name="SuppliesDataGrid"
            Grid.Row="3"
            Margin="0,10,0,0"
            AutoGenerateColumns="False"
            BorderBrush="#151719"
            CanUserAddRows="False"
            ColumnHeaderHeight="40"
            IsReadOnly="True"
            RowHeight="36">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding Id}"
                    Header="№" />
                <DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding Поставщик}"
                    Header="Поставщик" />
                <DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding Склад}"
                    Header="Склад" />
                <DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding Товар}"
                    Header="Товар" />
                <DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding Количество}"
                    Header="Количество" />
                <DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding Цена}"
                    Header="Закупочная цена" />
                <DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding Статус}"
                    Header="Статус" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
