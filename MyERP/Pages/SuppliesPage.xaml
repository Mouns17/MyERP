<Page
    x:Class="MyERP.Pages.SuppliesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MyERP.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="#FFFAF0"
    FontFamily="Segoe UI"
    mc:Ignorable="d">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,20"
            FontFamily="Segoe UI Black"
            FontSize="20"
            Foreground="#151719"
            Text="ПОСТАВКИ" />

        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <Button
                Padding="8"
                Background="Transparent"
                BorderBrush="#151719"
                BorderThickness="1,1,0,0"
                Click="Button_Click"
                Content="Поставки"
                FontSize="17"
                FontWeight="SemiBold" />
            <Button
                Padding="8"
                Background="Transparent"
                BorderBrush="#151719"
                BorderThickness="1,1,0,0"
                Click="Button_Click_1"
                Content="Поставщики"
                FontSize="17"
                FontWeight="SemiBold" />
            <Button
                Padding="8"
                Background="Transparent"
                BorderBrush="#151719"
                BorderThickness="1,1,0,0"
                Click="Button_Click_2"
                Content="Заказ поставщику"
                FontSize="17"
                FontWeight="SemiBold" />
            <Button
                Padding="8"
                Background="Transparent"
                BorderBrush="#151719"
                BorderThickness="1,1,1,0"
                Click="Button_Click_3"
                Content="Склады"
                FontSize="17"
                FontWeight="SemiBold" />
        </StackPanel>

        <Grid Grid.Row="2">
            <Border
                Background="Transparent"
                BorderBrush="#151719"
                BorderThickness="1">
                <Frame
                    x:Name="SuppliesFrame"
                    Background="Transparent"
                    NavigationUIVisibility="Hidden" />
            </Border>
        </Grid>
    </Grid>
</Page>
