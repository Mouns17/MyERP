<Page
    x:Class="MyERP.Pages.Sales.SaleDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#F3F4F6"
    FontFamily="Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,15">
            <TextBlock
                x:Name="TitleTextBlock"
                VerticalAlignment="Center"
                FontFamily="Segoe UI Black"
                FontSize="22"
                Foreground="#151719"
                Text="ПРОДАЖА" />

            <Button
                HorizontalAlignment="Right"
                Click="BackButton_Click"
                Content="НАЗАД"
                Style="{StaticResource BtnSecondary}" />
        </Grid>

        <Border
            Grid.Row="1"
            Margin="0,0,0,15"
            Padding="20"
            Background="White"
            CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect Color="Gray" Opacity="0.08" BlurRadius="10" ShadowDepth="2"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Margin="0,0,0,6" Foreground="#4B5563" Text="Покупатель" />
                    <ComboBox
                        x:Name="CustomerComboBox"
                        Height="36"
                        DisplayMemberPath="Наименование"
                        SelectedValuePath="Id" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="10,0">
                    <TextBlock Margin="0,0,0,6" Foreground="#4B5563" Text="Склад" />
                    <ComboBox
                        x:Name="WarehouseComboBox"
                        Height="36"
                        DisplayMemberPath="Наименование"
                        SelectedValuePath="Id" />
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="10,0">
                    <TextBlock Margin="0,0,0,6" Foreground="#4B5563" Text="Дата продажи" />
                    <DatePicker x:Name="SaleDatePicker" Height="36" />
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="10,0,0,0">
                    <TextBlock Margin="0,0,0,6" Foreground="#4B5563" Text="Статус" />
                    <TextBlock
                        x:Name="StatusTextBlock"
                        Height="36"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="#2563EB"
                        Text="Черновик" />
                </StackPanel>
            </Grid>
        </Border>

        <Border
            Grid.Row="2"
            Padding="20"
            Background="White"
            CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect Color="Gray" Opacity="0.08" BlurRadius="10" ShadowDepth="2"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    Margin="0,0,0,15"
                    FontFamily="Segoe UI Black"
                    FontSize="16"
                    Foreground="#151719"
                    Text="ТОВАРЫ ПРОДАЖИ" />

                <Grid Grid.Row="1" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Margin="0,0,0,5" Foreground="#4B5563" Text="Товар" />
                        <ComboBox
                            x:Name="ProductComboBox"
                            Height="36"
                            DisplayMemberPath="Наименование"
                            SelectedValuePath="Id"
                            SelectionChanged="ProductComboBox_SelectionChanged" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="5,0">
                        <TextBlock Margin="0,0,0,5" Foreground="#4B5563" Text="Количество" />
                        <TextBox
                            x:Name="QuantityTextBox"
                            Height="36"
                            VerticalContentAlignment="Center"
                            Text="1" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="5,0">
                        <TextBlock Margin="0,0,0,5" Foreground="#4B5563" Text="Цена" />
                        <TextBox
                            x:Name="PriceTextBox"
                            Height="36"
                            VerticalContentAlignment="Center" />
                    </StackPanel>

                    <Button
                        Grid.Column="3"
                        Margin="10,22,5,0"
                        Click="AddProductButton_Click"
                        Content="ДОБАВИТЬ"
                        Style="{StaticResource BtnPrimary}" />

                    <Button
                        Grid.Column="4"
                        Margin="5,22,0,0"
                        Click="RemoveProductButton_Click"
                        Content="УДАЛИТЬ"
                        Style="{StaticResource BtnDanger}" />
                </Grid>

                <DataGrid
                    x:Name="SaleItemsDataGrid"
                    Grid.Row="2"
                    AutoGenerateColumns="False"
                    Background="Transparent"
                    BorderThickness="0,1,0,0"
                    BorderBrush="#E5E7EB"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    CanUserReorderColumns="False"
                    CanUserResizeRows="False"
                    ColumnHeaderHeight="40"
                    Foreground="#151719"
                    GridLinesVisibility="Horizontal"
                    HeadersVisibility="Column"
                    HorizontalGridLinesBrush="#E5E7EB"
                    IsReadOnly="True"
                    RowHeight="40"
                    SelectionMode="Single"
                    SelectionUnit="FullRow">

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="White" />
                            <Setter Property="Foreground" Value="#151719" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="FontSize" Value="13" />
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F9FAFB" />
                            <Setter Property="Foreground" Value="#4B5563" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="FontSize" Value="14" />
                            <Setter Property="Height" Value="40" />
                            <Setter Property="Padding" Value="10,0" />
                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="BorderBrush" Value="#E5E7EB" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Width="55" Binding="{Binding Number}" Header="№" />
                        <DataGridTextColumn Width="*" Binding="{Binding Name}" Header="Наименование" />
                        <DataGridTextColumn Width="130" Binding="{Binding Quantity}" Header="Количество" />
                        <DataGridTextColumn Width="130" Binding="{Binding Price, StringFormat=N2}" Header="Цена" />
                        <DataGridTextColumn Width="150" Binding="{Binding Total, StringFormat=N2}" Header="Сумма" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,15,0,0">
            <TextBlock
                x:Name="TotalTextBlock"
                VerticalAlignment="Center"
                FontFamily="Segoe UI Black"
                FontSize="22"
                Foreground="#151719"
                Text="ИТОГО: 0,00 ₽" />

            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                    Margin="0,0,10,0"
                    Click="Button_Click"
                    Content="ПОДТВЕРДИТЬ ПРОДАЖУ"
                    Style="{StaticResource BtnSuccess}" />

                <Button
                    x:Name="SaveButton"
                    Click="SaveButton_Click"
                    Content="СОХРАНИТЬ ИЗМЕНЕНИЯ"
                    Style="{StaticResource BtnPrimary}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>