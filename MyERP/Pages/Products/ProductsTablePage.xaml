<Page
    x:Class="MyERP.Pages.Products.ProductsTablePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MyERP.Pages.Products"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="#FFFAF0"
    FontFamily="Segoe UI"
    mc:Ignorable="d">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <TextBox
                    x:Name="SearchTextBox"
                    Padding="8"
                    VerticalContentAlignment="Center"
                    Background="White"
                    BorderBrush="#D0D0D0"
                    Foreground="#151719"
                    TextChanged="SearchTextBox_TextChanged" />

                <TextBlock
                    Margin="9,0,0,0"
                    VerticalAlignment="Center"
                    Foreground="#999999"
                    IsHitTestVisible="False"
                    Text="Поиск товара...">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchTextBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <StackPanel
                Grid.Column="1"
                Margin="10,0,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">

                <Button
                    Margin="10,0,0,0"
                    Padding="8"
                    Click="AddProductButton_Click"
                    Content="ДОБАВИТЬ"
                    FontWeight="SemiBold" />

                <ComboBox
                    x:Name="CategoryComboBox"
                    Width="150"
                    Margin="10,0,0,0"
                    DisplayMemberPath="Наименование"
                    FontSize="15"
                    FontWeight="SemiBold"
                    IsEnabled="True"
                    SelectedValuePath="Id"
                    ToolTip="Категории" />

                <ComboBox
                    x:Name="UnitComboBox"
                    Width="150"
                    Margin="10,0,0,0"
                    DisplayMemberPath="Наименование"
                    FontSize="15"
                    FontWeight="SemiBold"
                    IsEnabled="True"
                    SelectedValuePath="Id"
                    ToolTip="Единицы измерения" />

                <Button
                    x:Name="SaveProductButton"
                    Margin="10,0,0,0"
                    Padding="8"
                    Click="SaveProductButton_Click"
                    Content="СОХРАНИТЬ"
                    FontWeight="SemiBold"
                    Visibility="Collapsed" />

                <Button
                    Margin="10,0,0,0"
                    Padding="8"
                    Content="ИМПОРТ"
                    FontWeight="SemiBold" />
            </StackPanel>
        </Grid>

        <DataGrid
            x:Name="ProductsDataGrid"
            Grid.Row="1"
            Margin="0,10,0,0"
            AlternatingRowBackground="#F5F2EA"
            AutoGenerateColumns="False"
            Background="#FFFAF0"
            BorderBrush="#151719"
            BorderThickness="1"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            CanUserReorderColumns="False"
            CanUserResizeColumns="False"
            CanUserResizeRows="False"
            CanUserSortColumns="True"
            ColumnHeaderHeight="40"
            Focusable="True"
            Foreground="#151719"
            GridLinesVisibility="All"
            HeadersVisibility="Column"
            HorizontalGridLinesBrush="#E5E5E5"
            IsReadOnly="False"
            RowBackground="#FFFAF0"
            RowHeight="25"
            SelectionMode="Single"
            SelectionUnit="CellOrRowHeader"
            VerticalGridLinesBrush="#E5E5E5">

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="#FFFAF0" />
                    <Setter Property="Foreground" Value="#151719" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="FontSize" Value="13" />
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#DCDCDC" />
                    <Setter Property="Foreground" Value="#151719" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="FontSize" Value="14" />
                    <Setter Property="Height" Value="40" />
                    <Setter Property="Padding" Value="10,0" />
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="BorderThickness" Value="0,0,1,1" />
                    <Setter Property="BorderBrush" Value="#C5C5C5" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#CECECE" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="40"
                    Binding="{Binding Id}"
                    Header="№"
                    IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="TextAlignment" Value="Center" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn
                    Width="*"
                    MinWidth="200"
                    Binding="{Binding Наименование, UpdateSourceTrigger=PropertyChanged}"
                    Header="Наименование" />
                <DataGridTextColumn
                    Width="120"
                    Binding="{Binding Цена, StringFormat={}{0:N2}, UpdateSourceTrigger=PropertyChanged}"
                    Header="Цена" />
                <DataGridTextColumn
                    Width="200"
                    Binding="{Binding Артикул, UpdateSourceTrigger=PropertyChanged}"
                    Header="Артикул" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
