<Page
    x:Class="MyERP.Pages.Supplies.SuppliersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MyERP.Pages.Supplies"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="#FFFAF0"
    mc:Ignorable="d">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DataGrid
            x:Name="SuppliersDataGrid"
            Grid.Row="1"
            Margin="0,10,0,0"
            AutoGenerateColumns="False"
            BorderBrush="#151719"
            CanUserAddRows="False"
            ColumnHeaderHeight="40"
            IsReadOnly="True"
            RowHeight="36">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding Id}"
                    Header="№" />
                <DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding Наименование}"
                    Header="Наименование" />
                <DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding ИНН}"
                    Header="ИНН" />
                <DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding Телефон}"
                    Header="Телефон" />
                <DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding ЭлПочта}"
                    Header="Эл. Почта" />
                <DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding Адрес}"
                    Header="Адрес" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
