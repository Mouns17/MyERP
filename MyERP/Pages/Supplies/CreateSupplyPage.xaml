<Page
    x:Class="MyERP.Pages.Supplies.CreateSupplyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#FFFAF0"
    FontFamily="Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,15">
            <TextBlock
                FontFamily="Segoe UI Black"
                FontSize="22"
                Foreground="#151719"
                Text="ОФОРМЛЕНИЕ ПОСТАВКИ (ПРИХОД)" />
            <Button
                HorizontalAlignment="Right"
                Background="#6B7280"
                Click="BackButton_Click"
                Content="НАЗАД"
                Style="{StaticResource BtnPrimary}" />
        </Grid>

        <Border
            Grid.Row="1"
            Margin="0,0,0,15"
            Padding="15"
            Background="White"
            CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="10"
                    Opacity="0.1"
                    ShadowDepth="2"
                    Color="Gray" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1.5*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="12"
                        Foreground="#6B7280"
                        Text="Поставщик" />
                    <ComboBox
                        x:Name="SupplierComboBox"
                        DisplayMemberPath="Наименование"
                        SelectedValuePath="Id" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="12"
                        Foreground="#6B7280"
                        Text="Склад приемки" />
                    <ComboBox
                        x:Name="WarehouseComboBox"
                        DisplayMemberPath="Наименование"
                        SelectedValuePath="Id" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="12"
                        Foreground="#6B7280"
                        Text="Фактическая дата поставки" />
                    <DatePicker x:Name="SupplyDatePicker" />
                </StackPanel>
            </Grid>
        </Border>

        <Border
            Grid.Row="2"
            Padding="0"
            Background="White"
            CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="15,10">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="Segoe UI Black"
                        FontSize="16"
                        Text="ПРИНЯТЫЕ ТОВАРЫ" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button
                            Margin="0,0,10,0"
                            Background="#4B5563"
                            Click="AddProduct_Click"
                            Content="+ ДОБАВИТЬ ТОВАР"
                            Style="{StaticResource BtnPrimary}" />
                        <Button
                            Click="DeleteProduct_Click"
                            Content="УДАЛИТЬ"
                            Style="{StaticResource BtnDanger}" />
                    </StackPanel>
                </Grid>

                <DataGrid
                    x:Name="ProductsDataGrid"
                    Grid.Row="1"
                    AutoGenerateColumns="False"
                    Background="Transparent"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,1,0,0"
                    CanUserAddRows="False"
                    ColumnHeaderHeight="40"
                    RowHeight="40">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F9FAFB" />
                            <Setter Property="Foreground" Value="#4B5563" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Padding" Value="10,0" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="50"
                            Binding="{Binding RowNumber}"
                            Header="№"
                            IsReadOnly="True" />
                        <DataGridTemplateColumn Width="*" Header="Товар">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox
                                        Margin="2"
                                        DisplayMemberPath="Наименование"
                                        ItemsSource="{Binding DataContext.ProductsList, RelativeSource={RelativeSource AncestorType=Page}}"
                                        SelectedValue="{Binding ProductId, UpdateSourceTrigger=PropertyChanged}"
                                        SelectedValuePath="Id"
                                        SelectionChanged="Product_SelectionChanged" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn
                            Width="120"
                            Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged, StringFormat=N3}"
                            Header="Количество" />
                        <DataGridTextColumn
                            Width="150"
                            Binding="{Binding Price, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                            Header="Закупочная цена" />
                        <DataGridTextColumn
                            Width="150"
                            Binding="{Binding Total, StringFormat=N2}"
                            Header="Сумма"
                            IsReadOnly="True" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,15,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    FontFamily="Segoe UI Black"
                    FontSize="20"
                    Foreground="#151719"
                    Text="ИТОГО:" />
                <TextBlock
                    x:Name="TotalTextBlock"
                    Margin="20,0,0,0"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Foreground="#151719"
                    Text="0,00 ₽" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                    Margin="0,0,10,0"
                    Background="#6B7280"
                    Click="SaveDraft_Click"
                    Content="СОХРАНИТЬ ЧЕРНОВИК"
                    Style="{StaticResource BtnPrimary}" />
                <!--  Кнопка проведения выделена зеленым!  -->
                <Button
                    Click="PostSupply_Click"
                    Content="ПРОВЕСТИ ПРИХОД"
                    Style="{StaticResource BtnSuccess}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>