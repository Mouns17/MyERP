<Page
    x:Class="MyERP.Pages.Supplies.SuppliesTablePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MyERP.Pages.Supplies"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="#FFFAF0"
    FontFamily="Segoe UI"
    mc:Ignorable="d">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Панель управления  -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <TextBox
                    x:Name="SearchTextBox"
                    Padding="8"
                    VerticalContentAlignment="Center"
                    Background="White"
                    BorderBrush="#D0D0D0"
                    Foreground="#151719"
                    TextChanged="SearchTextBox_TextChanged" />

                <TextBlock
                    Margin="9,0,0,0"
                    VerticalAlignment="Center"
                    Foreground="#999999"
                    IsHitTestVisible="False"
                    Text="Поиск поставок...">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchTextBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <StackPanel
                Grid.Column="1"
                Margin="10,0,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">

                <Button
                    Margin="10,0,0,0"
                    Padding="8"
                    Click="AddSuppliesButton_Click"
                    Content="ДОБАВИТЬ"
                    FontWeight="SemiBold" />

                <Button
                    x:Name="SaveSuppliesButton"
                    Margin="10,0,0,0"
                    Padding="8"
                    Click="SaveSuppliesButton_Click"
                    Content="СОХРАНИТЬ"
                    FontWeight="SemiBold"
                    Visibility="Collapsed" />

                <Button
                    Margin="10,0,0,0"
                    Padding="8"
                    Click="Button_Click"
                    Content="ИМПОРТ"
                    FontWeight="SemiBold" />

                <Button
                    Margin="10,0,0,0"
                    Padding="8"
                    Click="DeleteSuppliesButton_Click"
                    Content="УДАЛИТЬ"
                    FontWeight="SemiBold" />
            </StackPanel>
        </Grid>

        <DataGrid
            x:Name="SuppliesDataGrid"
            Grid.Row="1"
            Margin="0,10,0,0"
            AlternatingRowBackground="#F5F2EA"
            AutoGenerateColumns="False"
            Background="#FFFAF0"
            BorderBrush="#151719"
            BorderThickness="1"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            CanUserReorderColumns="False"
            CanUserResizeColumns="False"
            CanUserResizeRows="False"
            CanUserSortColumns="True"
            ColumnHeaderHeight="40"
            Focusable="True"
            Foreground="#151719"
            GridLinesVisibility="All"
            HeadersVisibility="Column"
            HorizontalGridLinesBrush="#E5E5E5"
            IsReadOnly="False"
            RowBackground="#FFFAF0"
            RowHeight="25"
            SelectionMode="Single"
            SelectionUnit="CellOrRowHeader"
            VerticalGridLinesBrush="#E5E5E5">

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="#FFFAF0" />
                    <Setter Property="Foreground" Value="#151719" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="FontSize" Value="13" />
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#DCDCDC" />
                    <Setter Property="Foreground" Value="#151719" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="FontSize" Value="14" />
                    <Setter Property="Height" Value="40" />
                    <Setter Property="Padding" Value="10,0" />
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="BorderThickness" Value="0,0,1,1" />
                    <Setter Property="BorderBrush" Value="#C5C5C5" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#CECECE" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="50"
                    Binding="{Binding Id}"
                    Header="№"
                    IsReadOnly="True" />
                <DataGridComboBoxColumn
                    x:Name="SupplierColumn"
                    Width="*"
                    DisplayMemberPath="Наименование"
                    Header="Поставщик"
                    SelectedValueBinding="{Binding id_поставщика, UpdateSourceTrigger=PropertyChanged}"
                    SelectedValuePath="Id" />
                <DataGridTemplateColumn Width="120" Header="Дата поставки">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                Text="{Binding Дата, StringFormat={}{0:dd.MM.yyyy}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <DatePicker
                                VerticalAlignment="Center"
                                BorderThickness="0"
                                SelectedDate="{Binding Дата, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                SelectedDateFormat="Short" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridComboBoxColumn
                    x:Name="WarehouseColumn"
                    Width="150"
                    DisplayMemberPath="Наименование"
                    Header="Склад"
                    SelectedValueBinding="{Binding id_склада, UpdateSourceTrigger=PropertyChanged}"
                    SelectedValuePath="Id" />
                <DataGridComboBoxColumn
                    x:Name="ProductColumn"
                    Width="150"
                    DisplayMemberPath="Наименование"
                    Header="Товар"
                    SelectedValueBinding="{Binding id_товара, UpdateSourceTrigger=PropertyChanged}"
                    SelectedValuePath="Id" />
                <DataGridTextColumn
                    Width="100"
                    Binding="{Binding Количество, UpdateSourceTrigger=PropertyChanged}"
                    Header="Количество" />
                <DataGridTextColumn
                    Width="140"
                    Binding="{Binding Цена, StringFormat={}{0:N2}, UpdateSourceTrigger=PropertyChanged}"
                    Header="Закупочная цена" />
                <DataGridComboBoxColumn
                    x:Name="StatusColumn"
                    Width="80"
                    DisplayMemberPath="Наименование"
                    Header="Статус"
                    SelectedValueBinding="{Binding id_статуса, UpdateSourceTrigger=PropertyChanged}"
                    SelectedValuePath="Id" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
