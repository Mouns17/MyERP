<Page
    x:Class="MyERP.Pages.Supplies.SuppliesTablePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MyERP.Pages.Supplies"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="#FFFAF0"
    mc:Ignorable="d">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DataGrid
            x:Name="SuppliesDataGrid"
            Grid.Row="1"
            Margin="0,10,0,0"
            AutoGenerateColumns="False"
            BorderBrush="#151719"
            CanUserAddRows="False"
            ColumnHeaderHeight="40"
            IsReadOnly="True"
            RowHeight="36">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding Id}"
                    Header="№" />
                <DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding Поставщик}"
                    Header="Поставщик" />
                <DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding Склад}"
                    Header="Склад" />
                <DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding Товар}"
                    Header="Товар" />
                <DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding Количество}"
                    Header="Количество" />
                <DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding Цена}"
                    Header="Закупочная цена" />
                <DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding Статус}"
                    Header="Статус" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
