<Page
    x:Class="MyERP.Pages.Supplies.SupplyDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#F3F4F6"
    FontFamily="Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,15">
            <TextBlock
                x:Name="SupplyTitleTextBlock"
                FontFamily="Segoe UI Black"
                FontSize="22"
                Foreground="#151719"
                Text="ПОСТАВКА" />
            <Button
                HorizontalAlignment="Right"
                Click="BackButton_Click"
                Content="НАЗАД"
                Style="{StaticResource BtnSecondary}" />
        </Grid>

        <Border
            Grid.Row="1"
            Margin="0,0,0,15"
            Padding="20"
            Background="White"
            CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="10"
                    Opacity="0.08"
                    ShadowDepth="2"
                    Color="Gray" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock
                        Margin="0,0,0,5"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="#6B7280"
                        Text="ПОСТАВЩИК" />
                    <TextBlock
                        x:Name="SupplierTextBlock"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="#151719"
                        Text="—"
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock
                        Margin="0,0,0,5"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="#6B7280"
                        Text="СКЛАД" />
                    <TextBlock
                        x:Name="WarehouseTextBlock"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="#151719"
                        Text="—"
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock
                        Margin="0,0,0,5"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="#6B7280"
                        Text="ДАТА ПОСТАВКИ" />
                    <TextBlock
                        x:Name="SupplyDateTextBlock"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="#151719"
                        Text="—" />
                </StackPanel>
            </Grid>
        </Border>

        <Border
            Grid.Row="2"
            Padding="0"
            Background="White"
            CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="10"
                    Opacity="0.08"
                    ShadowDepth="2"
                    Color="Gray" />
            </Border.Effect>
            <DataGrid
                x:Name="SupplyProductsDataGrid"
                AutoGenerateColumns="False"
                Background="Transparent"
                BorderThickness="0"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                CanUserReorderColumns="False"
                CanUserResizeColumns="False"
                ColumnHeaderHeight="40"
                GridLinesVisibility="Horizontal"
                HorizontalGridLinesBrush="#E5E7EB"
                IsReadOnly="True"
                RowHeight="40">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F9FAFB" />
                        <Setter Property="Foreground" Value="#4B5563" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Padding" Value="10,0" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="White" />
                        <Setter Property="Foreground" Value="#151719" />
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="60"
                        Binding="{Binding Номер}"
                        Header="№" />
                    <DataGridTextColumn
                        Width="*"
                        MinWidth="200"
                        Binding="{Binding Товар}"
                        Header="Товар" />
                    <DataGridTextColumn
                        Width="120"
                        Binding="{Binding Количество, StringFormat={}{0:N3}}"
                        Header="Количество" />
                    <DataGridTextColumn
                        Width="150"
                        Binding="{Binding Цена, StringFormat={}{0:N2} ₽}"
                        Header="Закупочная цена" />
                    <DataGridTextColumn
                        Width="150"
                        Binding="{Binding Сумма, StringFormat={}{0:N2} ₽}"
                        Header="Сумма" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="3" Margin="0,15,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    VerticalAlignment="Center"
                    FontFamily="Segoe UI Black"
                    FontSize="20"
                    Foreground="#151719"
                    Text="ИТОГО:" />
                <TextBlock
                    x:Name="TotalAmountTextBlock"
                    Margin="20,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="22"
                    FontWeight="Bold"
                    Foreground="#2563EB"
                    Text="0,00 ₽" />
            </StackPanel>
            <Button
                HorizontalAlignment="Right"
                Click="Button_Click"
                Content="ПОДТВЕРДИТЬ ПОСТАВКУ"
                Style="{StaticResource BtnSuccess}" />
        </Grid>
    </Grid>
</Page>