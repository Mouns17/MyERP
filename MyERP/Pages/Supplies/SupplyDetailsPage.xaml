<Page
    x:Class="MyERP.Pages.Supplies.SupplyDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#FFFAF0"
    FontFamily="Segoe UI">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Заголовок  -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <TextBlock
                    x:Name="SupplyTitleTextBlock"
                    FontFamily="Segoe UI Black"
                    FontSize="22"
                    Foreground="#151719"
                    Text="ПОСТАВКА" />
            </StackPanel>

            <Button
                Grid.Column="1"
                Click="BackButton_Click"
                Content="НАЗАД"
                Style="{StaticResource ButtonStyle}" />
        </Grid>

        <!--  Информация о поставке  -->
        <Border
            Grid.Row="1"
            Margin="0,15,0,15"
            Padding="15"
            Background="#FFFAF0"
            BorderBrush="#D0D0D0"
            BorderThickness="1">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="#777777"
                        Text="ПОСТАВЩИК" />

                    <TextBlock
                        x:Name="SupplierTextBlock"
                        Margin="0,5,10,0"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="#151719"
                        Text="—"
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="#777777"
                        Text="СКЛАД" />

                    <TextBlock
                        x:Name="WarehouseTextBlock"
                        Margin="0,5,10,0"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="#151719"
                        Text="—"
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="#777777"
                        Text="ДАТА ПОСТАВКИ" />

                    <TextBlock
                        x:Name="SupplyDateTextBlock"
                        Margin="0,5,0,0"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="#151719"
                        Text="—" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  Таблица товаров  -->
        <DataGrid
            x:Name="SupplyProductsDataGrid"
            Grid.Row="2"
            AlternatingRowBackground="#F5F2EA"
            AutoGenerateColumns="False"
            Background="#FFFAF0"
            BorderBrush="#151719"
            BorderThickness="1"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            CanUserReorderColumns="False"
            CanUserResizeColumns="False"
            CanUserResizeRows="False"
            CanUserSortColumns="True"
            ColumnHeaderHeight="40"
            Foreground="#151719"
            GridLinesVisibility="All"
            HeadersVisibility="Column"
            HorizontalGridLinesBrush="#E5E5E5"
            IsReadOnly="True"
            RowBackground="#FFFAF0"
            RowHeight="32"
            SelectionMode="Single"
            SelectionUnit="FullRow"
            VerticalGridLinesBrush="#E5E5E5">

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#DCDCDC" />
                    <Setter Property="Foreground" Value="#151719" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="FontSize" Value="14" />
                    <Setter Property="Height" Value="40" />
                    <Setter Property="Padding" Value="10,0" />
                    <Setter Property="BorderBrush" Value="#C5C5C5" />
                    <Setter Property="BorderThickness" Value="0,0,1,1" />
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="60"
                    Binding="{Binding Номер}"
                    Header="№" />

                <DataGridTextColumn
                    Width="*"
                    MinWidth="200"
                    Binding="{Binding Товар}"
                    Header="Товар" />

                <DataGridTextColumn
                    Width="150"
                    Binding="{Binding Количество, StringFormat={}{0:N3}}"
                    Header="Количество" />

                <DataGridTextColumn
                    Width="170"
                    Binding="{Binding Цена, StringFormat={}{0:N2} ₽}"
                    Header="Закупочная цена" />

                <DataGridTextColumn
                    Width="170"
                    Binding="{Binding Сумма, StringFormat={}{0:N2} ₽}"
                    Header="Сумма" />
            </DataGrid.Columns>
        </DataGrid>

        <!--  Итоговая сумма  -->
        <Border
            Grid.Row="3"
            Margin="0,12,0,0"
            Padding="15"
            Background="#FFFAF0"
            BorderBrush="#D0D0D0"
            BorderThickness="1">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    VerticalAlignment="Center"
                    FontFamily="Segoe UI Black"
                    FontSize="16"
                    Foreground="#151719"
                    Text="ИТОГО:" />

                <TextBlock
                    x:Name="TotalAmountTextBlock"
                    Grid.Column="0"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Foreground="#151719"
                    Text="0,00 ₽" />

                <Button
                    Grid.Column="1"
                    Click="Button_Click"
                    Content="ПОДТВЕРДИТЬ ПОСТАВКУ"
                    Style="{StaticResource ButtonStyle}" />
            </Grid>
        </Border>
    </Grid>
</Page>
