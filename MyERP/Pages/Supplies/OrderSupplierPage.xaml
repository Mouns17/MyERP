<Page
    x:Class="MyERP.Pages.Supplies.OrderSupplierPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#F3F4F6"
    FontFamily="Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,15"
            FontFamily="Segoe UI Black"
            FontSize="22"
            Foreground="#151719"
            Text="ЗАКАЗЫ ПОСТАВЩИКАМ" />

        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <TextBox
                    x:Name="SearchTextBox"
                    Padding="10,8"
                    VerticalContentAlignment="Center"
                    Background="White"
                    BorderBrush="#D1D5DB"
                    Foreground="#151719"
                    TextChanged="SearchTextBox_TextChanged" />
                <TextBlock
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Foreground="#9CA3AF"
                    IsHitTestVisible="False"
                    Text="Поиск заказа...">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchTextBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    Margin="10,0,0,0"
                    Click="CreateOrderButton_Click"
                    Content="СОЗДАТЬ ЗАКАЗ"
                    Style="{StaticResource BtnPrimary}" />
                <Button
                    Margin="10,0,0,0"
                    Click="OpenOrderButton_Click"
                    Content="ОТКРЫТЬ"
                    Style="{StaticResource BtnSecondary}" />
                <Button
                    Margin="10,0,0,0"
                    Click="CancelOrderButton_Click"
                    Content="ОТМЕНИТЬ"
                    Style="{StaticResource BtnDanger}" />
            </StackPanel>
        </Grid>

        <Border
            Grid.Row="2"
            Padding="0"
            Background="White"
            CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="10"
                    Opacity="0.08"
                    ShadowDepth="2"
                    Color="Gray" />
            </Border.Effect>
            <DataGrid
                x:Name="SupplierOrdersDataGrid"
                AutoGenerateColumns="False"
                Background="Transparent"
                BorderThickness="0"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                CanUserReorderColumns="False"
                CanUserResizeColumns="False"
                ColumnHeaderHeight="40"
                GridLinesVisibility="Horizontal"
                HorizontalGridLinesBrush="#E5E7EB"
                IsReadOnly="True"
                RowHeight="40">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F9FAFB" />
                        <Setter Property="Foreground" Value="#4B5563" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Padding" Value="10,0" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="White" />
                        <Setter Property="Foreground" Value="#151719" />
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="60"
                        Binding="{Binding Id}"
                        Header="№" />
                    <DataGridTextColumn
                        Width="*"
                        MinWidth="150"
                        Binding="{Binding Поставщик}"
                        Header="Поставщик" />
                    <DataGridTextColumn
                        Width="120"
                        Binding="{Binding ДатаЗаказа, StringFormat={}{0:dd.MM.yyyy}}"
                        Header="Дата заказа" />
                    <DataGridTextColumn
                        Width="120"
                        Binding="{Binding ОжидаемаяДата, StringFormat={}{0:dd.MM.yyyy}}"
                        Header="Ожидается" />
                    <DataGridTextColumn
                        Width="150"
                        Binding="{Binding Склад}"
                        Header="Склад" />
                    <DataGridTextColumn
                        Width="120"
                        Binding="{Binding Сумма, StringFormat={}{0:N2} ₽}"
                        Header="Сумма" />
                    <DataGridTextColumn
                        Width="120"
                        Binding="{Binding Статус}"
                        Header="Статус" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>