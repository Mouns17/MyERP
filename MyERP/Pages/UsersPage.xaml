<Page
    x:Class="MyERP.Pages.UsersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#F3F4F6"
    FontFamily="Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,15"
            FontFamily="Segoe UI Black"
            FontSize="22"
            Foreground="#151719"
            Text="ПОЛЬЗОВАТЕЛИ" />

        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <TextBox
                    x:Name="SearchTextBox"
                    Padding="10,8"
                    VerticalContentAlignment="Center"
                    Background="White"
                    BorderBrush="#D1D5DB"
                    Foreground="#151719"
                    TextChanged="SearchTextBox_TextChanged" />
                <TextBlock
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Foreground="#9CA3AF"
                    IsHitTestVisible="False"
                    Text="Поиск пользователя...">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchTextBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    Margin="10,0,0,0"
                    Click="AddUserButton_Click"
                    Content="ДОБАВИТЬ"
                    Style="{StaticResource BtnPrimary}" />
                <Button
                    x:Name="SaveUserButton"
                    Margin="10,0,0,0"
                    Click="SaveUserButton_Click"
                    Content="СОХРАНИТЬ"
                    Style="{StaticResource BtnSuccess}"
                    Visibility="Collapsed" />
                <Button
                    Margin="10,0,0,0"
                    Click="DeleteUserButton_Click"
                    Content="УДАЛИТЬ"
                    Style="{StaticResource BtnDanger}" />
            </StackPanel>
        </Grid>

        <Border
            Grid.Row="2"
            Padding="0"
            Background="White"
            CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="10"
                    Opacity="0.08"
                    ShadowDepth="2"
                    Color="Gray" />
            </Border.Effect>
            <DataGrid
                x:Name="UsersDataGrid"
                AutoGenerateColumns="False"
                Background="Transparent"
                BorderThickness="0"
                CanUserAddRows="True"
                CanUserDeleteRows="False"
                CanUserReorderColumns="False"
                CanUserResizeColumns="False"
                ColumnHeaderHeight="40"
                GridLinesVisibility="Horizontal"
                HorizontalGridLinesBrush="#E5E7EB"
                IsReadOnly="False"
                RowHeight="40">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F9FAFB" />
                        <Setter Property="Foreground" Value="#4B5563" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Padding" Value="10,0" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="White" />
                        <Setter Property="Foreground" Value="#151719" />
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="40"
                        Binding="{Binding Id}"
                        Header="№"
                        IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center" />
                                <Setter Property="TextAlignment" Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn
                        Width="*"
                        MinWidth="200"
                        Binding="{Binding Имя, UpdateSourceTrigger=PropertyChanged}"
                        Header="Имя пользователя" />
                    <DataGridTextColumn
                        Width="150"
                        Binding="{Binding Логин, UpdateSourceTrigger=PropertyChanged}"
                        Header="Логин" />
                    <DataGridTextColumn
                        Width="150"
                        Binding="{Binding Пароль, UpdateSourceTrigger=PropertyChanged}"
                        Header="Пароль" />
                    <DataGridComboBoxColumn
                        x:Name="UserRoleColumn"
                        Width="180"
                        DisplayMemberPath="Название"
                        Header="Роль"
                        SelectedValueBinding="{Binding id_роли, UpdateSourceTrigger=PropertyChanged}"
                        SelectedValuePath="Id" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>